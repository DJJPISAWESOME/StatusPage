{
  "name": "signal-status-dashboard",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "deploy": "npm run build && wrangler deploy",
    "preview": "node scripts/preview.mjs",
    "webhook": "node scripts/send-webhook.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:runtime": "wrangler deploy --dry-run --outdir artifacts/worker && node scripts/runtime-smoke.mjs",
    "test:live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.40.0",
    "@axe-core/playwright": "^4.11.0"
  }
}
