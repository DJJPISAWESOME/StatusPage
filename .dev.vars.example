# Copy to .dev.vars for local development only. Never commit secrets.
# Per-service JSON: generate each value with `openssl rand -hex 32`.
WEBHOOK_SECRETS={"cloudflare":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"}
# Optional native Statuspage callback tokens. Invalidation only, never trusts payload status.
STATUSPAGE_TOKENS={"cloudflare":"REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN"}
